    "/api/v1/restaurants": {
      "get": {
        "tags": [
          "Restaurants"
        ],
        "summary": "Searches restaurants by neighborhood and delivery fee.",
        "parameters": [
          {
            "name": "Area",
            "in": "query",
            "description": "Filter by one neighborhood.",
            "schema": {
              "maxLength": 50,
              "minLength": 0,
              "type": "string",
              "example": "Bole"
            },
            "example": "Bole"
          },
          {
            "name": "Areas",
            "in": "query",
            "description": "Filter by multiple neighborhoods.",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "example": [
                "Bole",
                "Piassa"
              ]
            },
            "example": [
              "Bole",
              "Piassa"
            ]
          },
          {
            "name": "MaxFeeEtb",
            "in": "query",
            "description": "Maximum delivery fee in Ethiopian birr.",
            "schema": {
              "type": "number",
              "format": "double",
              "example": 35
            },
            "example": 35
          },
          {
            "name": "Page",
            "in": "query",
            "description": "One-based result page.",
            "schema": {
              "maximum": 2147483647,
              "minimum": 1,
              "type": "integer",
              "format": "int32",
              "example": 1
            },
            "example": 1
          },
          {
            "name": "Limit",
            "in": "query",
            "description": "Number of restaurants per page, from 1 to 100.",
            "schema": {
              "maximum": 100,
              "minimum": 1,
              "type": "integer",
              "format": "int32",
              "example": 5
            },
            "example": 5
          }
        ],
        "responses": {
          "200": {
            "description": "Returns the matching restaurants.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/RestaurantDto"
